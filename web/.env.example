# ─────────────────────────────────────────────────────────────
# CUPULO STORE — variáveis do SITE (copie para .env e preencha)
# Na Vercel: Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Convite do servidor do Discord (botões "Entrar no Discord")
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/seu-convite"

# ── Banco (Supabase → Project Settings → Database → Connection string)
# Pooler "Transaction" (porta 6543) para o app:
DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão "Session"/direta (porta 5432) para migrations:
DIRECT_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Auth.js / Login com Discord
# Gere com: npx auth secret   (ou: openssl rand -base64 33)
AUTH_SECRET=""
# Discord Developer Portal → sua aplicação → OAuth2
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# IDs do Discord dos administradores, separados por vírgula
ADMIN_DISCORD_IDS="123456789012345678"

# ── Segredos internos (gere cada um com: openssl rand -hex 32)
# Usado para o hash das keys. NUNCA troque depois de gerar keys (as antigas param de funcionar).
KEY_PEPPER=""
# Token que o bot usa para chamar /api/bot/* (o mesmo valor vai no .env do bot)
BOT_API_TOKEN=""

# Webhook de um canal do Discord para avisar resgates (opcional)
DISCORD_WEBHOOK_URL=""

# ── Supabase Storage (Project Settings → API)
SUPABASE_URL="https://xxxx.supabase.co"
# service_role: só no servidor, nunca com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket PRIVADO com os arquivos dos packs
SUPABASE_BUCKET_PACKS="packs"
# Bucket PÚBLICO com as imagens dos produtos
SUPABASE_BUCKET_IMAGES="imagens"

# ── Somente desenvolvimento local
# Login de teste sem Discord (ignorado fora de `npm run dev`)
AUTH_DEV_LOGIN="false"
