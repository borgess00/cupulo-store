# ─────────────────────────────────────────────────────────────
# CUPULO STORE — variáveis do BOT (copie para .env e preencha)
# ─────────────────────────────────────────────────────────────

# Discord Developer Portal → sua aplicação → Bot → Reset Token
DISCORD_TOKEN=""
# Discord Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=""
# ID do seu servidor (clique direito no servidor → Copiar ID)
DISCORD_GUILD_ID=""

# Cargos que podem usar /gerarkey, /entregar, /consultarkey e /acessos (IDs separados por vírgula)
STAFF_ROLE_IDS=""
# Cargo "Cliente" dado ao entregar uma key (opcional — deixe vazio para não dar cargo)
CLIENT_ROLE_ID=""
# Canal onde o bot registra cada entrega (opcional)
DELIVERY_LOG_CHANNEL_ID=""

# Endereço público do site (sem barra no final)
SITE_URL="https://seu-site.vercel.app"
# O MESMO valor de BOT_API_TOKEN configurado no site
BOT_API_TOKEN=""
